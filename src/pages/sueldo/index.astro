---
import Layout from '../../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR } from '../../config';
import { buildBreadcrumbSchema } from '../../lib/seo';
import { allSalaryPages, montantsAvecPageDediee, formatAmountSpanish } from '../../data/salary-pages-config';

/** Une page de detail n'existe que pour les montants retenus (cf. config). */
const aUnePage = (p: { amount: number; period: string }) =>
  p.period === 'año' && (montantsAvecPageDediee as readonly number[]).includes(p.amount);
import { calcularSueldoNeto, situacionFamiliarDefecto } from '../../lib/irpf-engine';
import { formatEuros } from '../../lib/format-es';

const title = `Tabla Sueldo Bruto a Neto ${CURRENT_FISCAL_YEAR} España: Todos los Importes`;
const description = `¿Cuánto neto queda de cada salario bruto? Tabla completa con importes mensuales y anuales, IRPF y Seguridad Social desglosados. Datos actualizados ${CURRENT_FISCAL_YEAR}.`;

const monthlyPages = allSalaryPages.filter(p => p.period === 'mes');
const annualPages = allSalaryPages.filter(p => p.period === 'año');

function getNet(annualGross: number): number {
  return calcularSueldoNeto(annualGross, 'MD', situacionFamiliarDefecto, 14).netoMensual;
}

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Sueldos', url: '/sueldo/' },
  ]),
];
const faqPage = [
  { question: '¿Cómo se calculan estas cifras?', answer: 'Cada página aplica la escala estatal del IRPF, la escala autonómica de Madrid como referencia y los tipos de cotización vigentes en 2026, suponiendo contribuyente soltero sin hijos y catorce pagas. El resto de comunidades y situaciones familiares se calculan en la calculadora principal.' },
  { question: '¿Por qué se usa Madrid como referencia?', answer: 'Porque tiene la escala autonómica más baja, lo que ofrece un punto de comparación estable. En Cataluña o la Comunidad Valenciana el neto resultante es algo menor con el mismo bruto, y la diferencia crece a medida que sube el salario.' },
  { question: '¿Las cifras incluyen pagas extra?', answer: 'Sí. El importe anual es el mismo con doce o con catorce pagas; lo que cambia es el reparto mensual. Las páginas muestran ambos escenarios porque la elección afecta a la tesorería del hogar, no al total percibido en el año.' },
  { question: '¿Qué no reflejan estas páginas?', answer: 'No incluyen beneficios en especie, seguros médicos, cheques restaurante ni planes de pensiones de empresa, que modifican el neto real. Tampoco recogen las deducciones autonómicas por vivienda, hijos o discapacidad, que se aplican en la declaración anual. Cada página enlaza la fuente oficial aplicable, para que cualquier cifra pueda contrastarse sin depender de nosotros.' },

  { question: '¿Qué salario debo buscar en esta lista?', answer: 'El importe bruto que figura en tu contrato o en la oferta que estás valorando. Las páginas están organizadas por salario mensual y por salario anual, de modo que puedes entrar por la cifra que conozcas sin hacer ninguna conversión previa.' },
  { question: '¿Por qué el neto difiere de mi nómina real?', answer: 'Porque estas páginas asumen contribuyente soltero sin hijos en Madrid y no incluyen beneficios en especie, seguros médicos ni planes de empresa. Tu situación familiar, tu comunidad autónoma y los conceptos propios de tu convenio explican casi siempre la diferencia.' },
];
const faqPageSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqPage.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
import ContextoFiscal from '../../components/ContextoFiscal.astro';
---

<Layout title={title} description={description} schema={schemas}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray">
      <a href="/" class="hover:text-brand">Inicio</a> / <span class="text-charcoal dark:text-gray-200">Sueldos</span>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      Tabla de Sueldo Bruto a Neto en España ({CURRENT_FISCAL_YEAR})
    </h1>

    <p class="mb-8 text-lg text-dark-gray dark:text-gray-300">
      Consulta el sueldo neto aproximado para los importes brutos más buscados en España.
      Cada enlace lleva a una página detallada con desglose por comunidad autónoma y situación familiar. Cada página parte de un salario bruto anual y baja hasta el neto mensual, aplicando la Seguridad Social al 6,35 % en un contrato indefinido estándar, las escalas estatal y autonómica del IRPF, y el mínimo personal y familiar. El resultado se muestra para las diecisiete comunidades autónomas, porque es en la mitad autonómica del impuesto donde aparecen las diferencias, y para las situaciones familiares más frecuentes. Las cifras suponen doce o catorce pagas según se indique, sin retribución en especie ni deducciones distintas de las generales. Quien tenga coche de empresa, stock options o un segundo pagador verá una cifra distinta, y conviene que un asesor confirme cualquier decisión que dependa de ella.
    </p>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-charcoal dark:text-gray-100">Por salario mensual</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-700">
              <th class="px-4 py-2 text-left font-medium text-gray-500">Bruto/mes</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Neto/mes (Madrid)</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">Bruto/año</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500"></th>
            </tr>
          </thead>
          <tbody>
            {monthlyPages.map(p => (
              <tr class="border-t border-gray-100 dark:border-gray-700">
                <td class="px-4 py-2 font-medium text-charcoal dark:text-gray-100">{formatAmountSpanish(p.amount)} €</td>
                <td class="px-4 py-2 text-right tabular-nums font-medium text-emerald-700 dark:text-emerald-400">{formatEuros(getNet(p.annualGross))}</td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-500">{formatAmountSpanish(p.annualGross)} €</td>
                <td class="px-4 py-2">{aUnePage(p)
                  ? <a href={`/sueldo/${p.slug}/`} class="text-brand hover:underline">Ver detalle</a>
                  : null}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-charcoal dark:text-gray-100">Por salario anual</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-700">
              <th class="px-4 py-2 text-left font-medium text-gray-500">Bruto/año</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Neto/mes (Madrid)</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Bruto/mes</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500"></th>
            </tr>
          </thead>
          <tbody>
            {annualPages.map(p => (
              <tr class="border-t border-gray-100 dark:border-gray-700">
                <td class="px-4 py-2 font-medium text-charcoal dark:text-gray-100">{formatAmountSpanish(p.amount)} €</td>
                <td class="px-4 py-2 text-right tabular-nums font-medium text-emerald-700 dark:text-emerald-400">{formatEuros(getNet(p.annualGross))}</td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-500">{formatAmountSpanish(Math.round(p.annualGross / 14))} €</td>
                <td class="px-4 py-2">{aUnePage(p)
                  ? <a href={`/sueldo/${p.slug}/`} class="text-brand hover:underline">Ver detalle</a>
                  : null}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="text-xs text-medium-gray">
      <p>Cálculo para persona soltera, sin hijos, Madrid, 14 pagas. Ejercicio fiscal {CURRENT_FISCAL_YEAR}.</p>
    </div>
  </div>

  <!-- Fuentes oficiales (RECETTE §7) -->
  <section class="mx-auto max-w-6xl px-4 pb-12 text-sm text-slate-600">
    <h2 class="text-lg font-semibold text-slate-900 mb-3">Fuentes oficiales</h2>
    <ul class="list-disc pl-6 space-y-1">
      <li><a class="underline" href="https://www.agenciatributaria.es" rel="noopener">Agencia Tributaria</a> — IRPF y retenciones</li>
      <li><a class="underline" href="https://www.seg-social.es" rel="noopener">Seguridad Social</a> — bases y cuotas de cotización</li>
      <li><a class="underline" href="https://www.sepe.es" rel="noopener">SEPE</a> — prestación por desempleo</li>
      <li><a class="underline" href="https://www.boe.es" rel="noopener">BOE</a> — normativa en vigor</li>
    </ul>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="mb-4 text-2xl font-bold">Preguntas frecuentes</h2>
    <div class="space-y-3">
      {faqPage.map((f) => (
        <details class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <summary class="cursor-pointer font-semibold">{f.question}</summary>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <ContextoFiscal />
</Layout>
