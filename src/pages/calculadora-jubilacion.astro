---
import CalculadoraLayout from '../layouts/CalculadoraLayout.astro';
import Jubilacion from '../components/calculadoras/Jubilacion';
import { calcularJubilacion, porcentajePorMeses, PARAMS_JUBILACION as J } from '../lib/jubilacion-engine';
import { fuentesJubilacion, eurES as eur, numES as num } from '../lib/fuentes';

const hoy = new Date().toISOString().slice(0, 10);
const ref = { hoyAnio: 2026, hoyMes: 10 };
const ana = calcularJubilacion({ anioNacimiento: 1961, mesNacimiento: 3, mesesCotizadosHoy: 470, baseActual: 2600, ...ref });
const luis = calcularJubilacion({ anioNacimiento: 1960, mesNacimiento: 2, mesesCotizadosHoy: 400, baseActual: 2100, ...ref });
const marta = calcularJubilacion({ anioNacimiento: 1964, mesNacimiento: 6, mesesCotizadosHoy: 420, baseActual: 2400, ...ref });
const martaAnt = calcularJubilacion({ anioNacimiento: 1964, mesNacimiento: 6, mesesCotizadosHoy: 420, baseActual: 2400, edadDeseadaMeses: 780, ...ref });
const rosa = calcularJubilacion({ anioNacimiento: 1961, mesNacimiento: 5, mesesCotizadosHoy: 216, baseActual: 1424.4, situacion: 'conyugeACargo', ...ref });
const E26 = J.edad['2026'], E27 = J.edad['2027'];
const edad = (m: number) => `${Math.floor(m / 12)} años${m % 12 ? ` y ${m % 12} meses` : ''}`;
const N26 = J.baseReguladora.nueva['2026'];
const mens = (a: number) => eur(J.minimasAnuales['65'][a === 0 ? 'conyugeACargo' : a === 1 ? 'unipersonal' : 'conyugeNoACargo'] / J.pagasAnuales);
const CV = J.anticipada.coefVoluntaria as Record<string, number[]>, CI = J.anticipada.coefInvoluntaria as Record<string, number[]>;
const escala = [15, 20, 25, 30, 35, 36.5].map((a) => ({ a, p26: porcentajePorMeses(Math.round(a * 12), 2026), p27: porcentajePorMeses(Math.round(a * 12), 2027) }));

const title = 'Pensión de jubilación 2026: simulador con las dos fórmulas';
const description = 'Simula tu pensión de jubilación 2026: base reguladora con las dos fórmulas, porcentaje por años cotizados, edad legal, anticipada y pensión mínima y máxima.';
const faqs = [
  { question: '¿Cuál es el mínimo de años cotizados para tener pensión contributiva?', answer: `Quince años como mínimo, de los que al menos dos deben estar dentro de los quince anteriores a la jubilación. Con quince años se cobra el ${J.porcentaje.base} % de la base reguladora. En 2026, el 100 % exige 36 años y 6 meses; desde 2027 harán falta 37 años, porque cambia la escala de porcentajes.` },
  { question: '¿Cuál es la edad ordinaria de jubilación en 2026 y en 2027?', answer: `A los 65 años si acreditas 38 años y 3 meses cotizados o más; si no, a los ${edad(E26.edadSinUmbralMeses)}. Desde 2027 el calendario termina: 65 años con 38 años y 6 meses cotizados y, en otro caso, ${edad(E27.edadSinUmbralMeses)} (disposición transitoria 7.ª de la Ley General de la Seguridad Social).` },
  { question: '¿Cómo se calcula la base reguladora desde 2026?', answer: `La Seguridad Social calcula dos bases y aplica la mejor. La de siempre suma las bases de los últimos 300 meses y divide entre 350. La nueva toma en 2026 las ${N26[1]} bases más altas de los últimos ${N26[0]} meses y divide entre ${num(N26[2], 2)}. El periodo nuevo crece cada año hasta llegar en 2037 a 29 años con los 24 peores meses descartados.` },
  { question: '¿Cuál es la pensión máxima de jubilación en 2026?', answer: `${eur(J.pensionMaximaMensual)} al mes en 14 pagas, ${eur(J.pensionMaximaAnual)} al año, según el Real Decreto-ley 3/2026. Desde 2025 el tope sube cada año con el IPC más un incremento adicional, de modo que la pensión máxima se acerque poco a poco a la base máxima de cotización.` },
  { question: '¿Cuánto se pierde con la jubilación anticipada?', answer: `Depende de los meses de adelanto y de los años cotizados. En la voluntaria, con un máximo de 24 meses y 35 años cotizados, el recorte va del ${num(CV['1'][3], 2)} % por un mes al ${num(CV['24'][0], 2)} % por dos años. En la involuntaria, tras un despido, puede adelantarse hasta 48 meses con un recorte de hasta el ${num(CI['48'][0], 2)} %. La pérdida es para toda la vida.` },
  { question: '¿Qué gano si retraso la jubilación?', answer: `Un ${J.demora.porcentajeAnual} % más de pensión por cada año completo trabajado después de la edad ordinaria y, desde el segundo año, un ${J.demora.porcentajeSemestre} % por cada semestre adicional. También puede elegirse un pago único o una combinación. Si la pensión ya alcanza la máxima, el porcentaje no aprovechado se cobra aparte cada año.` },
  { question: '¿El simulador sustituye al de la Seguridad Social?', answer: 'No. El simulador oficial de Tu Seguridad Social conoce tu vida laboral real mes a mes. Este simulador reconstruye tus bases a partir de la base actual y de su evolución, en euros de 2026, y sirve para comparar escenarios: anticipada, demora, lagunas o la fórmula que te favorece.' },
];
---

<CalculadoraLayout title={title} description={description} h1="Simulador de pensión de jubilación 2026" calculatorName="Simulador de jubilación" path="/calculadora-jubilacion/" faqs={faqs} sources={fuentesJubilacion}>
  <p class="mb-6 text-lg text-dark-gray dark:text-gray-300">
    La pensión de jubilación se obtiene aplicando a la base reguladora (la media de tus bases de cotización) un porcentaje que depende de los años cotizados: el {J.porcentaje.base} % con 15 años y el 100 % con 36 años y 6 meses en 2026. Desde enero de 2026 la Seguridad Social calcula la base de dos maneras y aplica la más favorable: la clásica, 300 meses entre 350, y la nueva, que en 2026 suma las {N26[1]} mejores bases de los últimos {N26[0]} meses y divide entre {num(N26[2], 2)}. Con 39 años cotizados y una base de 2.600 € al mes, una persona nacida en marzo de 1961 que se jubila ahora cobra {eur(ana.pensionMensual)} al mes en 14 pagas. La pensión no puede pasar de {eur(J.pensionMaximaMensual)} ni, si tus ingresos son bajos, quedar por debajo de la mínima. El simulador calcula también la edad ordinaria que te corresponde y el efecto de adelantar o retrasar la jubilación.
  </p>
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800" data-chrome>
    <Jubilacion client:idle hoy={hoy} />
  </div>

  <section class="mt-8">
    <div class="prose max-w-none text-dark-gray dark:text-gray-300 leading-relaxed">
      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">La reforma de 2026: dos bases reguladoras y gana la mejor</h2>
      <p>
        El Real Decreto-ley 2/2023 alargó el periodo de cálculo de la pensión, pero con una red: hasta 2040, la entidad gestora compara de oficio la base calculada con la fórmula de 2023 y la calculada con la nueva, y aplica la mayor (disposición transitoria cuarta, apartado 7, de la Ley General de la Seguridad Social). La fórmula nueva no llega de golpe a los famosos «29 años»: en 2026 cubre {N26[0]} meses y descarta los dos peores; cada año añade cuatro meses al periodo y un mes más al descarte, hasta 2037, cuando se aplicará entera: 348 meses, las 324 mejores bases, entre 378.
      </p>
      <p>
        ¿A quién beneficia? A quien tuvo meses malos al final de su carrera (paro, reducción de jornada, un contrato peor pagado), porque la nueva fórmula los puede descartar. A quien cobró sus mejores sueldos hace tiempo, porque mira más atrás. A quien ha ido subiendo de sueldo hasta el final, en cambio, le conviene la fórmula clásica, que solo mira los últimos 25 años: por eso la ley le deja elegirla. El simulador muestra las dos cifras y marca la que se aplica.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Porcentaje por años cotizados</h2>
      <p>
        Los primeros 15 años dan el {J.porcentaje.base} %. Hasta finales de 2026, cada uno de los primeros 49 meses adicionales suma un 0,21 % y cada uno de los 209 siguientes un 0,19 %; desde 2027, la escala pasa a 248 meses a 0,19 % y 16 meses a 0,18 %, de modo que el 100 % exigirá 37 años (disposición transitoria novena).
      </p>
      <div class="overflow-x-auto">
        <table class="my-4 w-full border-collapse text-sm">
          <caption class="sr-only">Porcentaje de la base reguladora según los años cotizados</caption>
          <thead><tr class="border-b-2 border-gray-300 dark:border-gray-600"><th scope="col" class="px-3 py-2 text-left">Años cotizados</th><th scope="col" class="px-3 py-2 text-right">Jubilación en 2026</th><th scope="col" class="px-3 py-2 text-right">Jubilación desde 2027</th></tr></thead>
          <tbody class="tabular-nums">
            {escala.map((e) => <tr class="border-b border-gray-100 dark:border-gray-700"><td class="px-3 py-1">{num(e.a, 1)}</td><td class="px-3 py-1 text-right">{num(e.p26, 2)} %</td><td class="px-3 py-1 text-right">{num(e.p27, 2)} %</td></tr>)}
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Edad ordinaria: 2026 es el último año del calendario</h2>
      <p>
        En 2026, la edad ordinaria es de 65 años para quien acredita 38 años y 3 meses cotizados y de {edad(E26.edadSinUmbralMeses)} para el resto. Desde 2027, 65 años con 38 años y 6 meses y {edad(E27.edadSinUmbralMeses)} en otro caso. La regla mira el año en que se alcanza cada edad, por eso alguien nacido en febrero de 1960 con 33 años y 4 meses cotizados se jubila a los {edad(luis.edadOrdinariaMeses)} en diciembre de 2026, con el {num(luis.porcentaje, 2)} % de su base: {eur(luis.pensionMensual)} al mes. Nacer dos meses después le habría llevado a los 67.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Anticipar o retrasar</h2>
      <p>
        Una mujer nacida en junio de 1964, con 35 años cotizados y una base de 2.400 €, tiene su edad ordinaria en los {edad(marta.edadOrdinariaMeses)}: en junio de {marta.anioHecho} cobraría {eur(marta.pensionMensual)}. Si se jubila voluntariamente a los 65, adelanta {martaAnt.mesesAnticipo} meses y el coeficiente del artículo 208 le resta un {num(martaAnt.coeficiente * 100, 2)} %: {eur(martaAnt.pensionMensual)} al mes, de por vida. La anticipada voluntaria exige 35 años cotizados y que la pensión resultante supere la mínima; la involuntaria, tras un despido o un ERE, 33 años y la inscripción como demandante de empleo durante seis meses. Los coeficientes completos están en la <a href="/guias/jubilacion-anticipada-coeficientes/" class="text-brand hover:underline">guía de la jubilación anticipada</a>.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Pensión mínima y máxima en 2026</h2>
      <p>
        El Real Decreto-ley 3/2026 fija la pensión máxima en {eur(J.pensionMaximaMensual)} al mes y las mínimas de jubilación a partir de los 65 años en {mens(0)} con cónyuge a cargo, {mens(1)} sin cónyuge y {mens(2)} con cónyuge no a cargo, en 14 pagas. El complemento a mínimos solo se paga si los demás ingresos no superan {eur(J.limiteIngresosMinimos.sinConyuge)} al año ({eur(J.limiteIngresosMinimos.conConyuge)} con cónyuge a cargo). Una trabajadora con 18 años cotizados a la base mínima y cónyuge a cargo tendría una pensión contributiva de {eur(rosa.pensionCalculada)} que el complemento eleva a {eur(rosa.pensionMensual)}. Las cuantías están en la <a href="/guias/pension-minima-maxima-jubilacion/" class="text-brand hover:underline">guía de la pensión mínima y máxima</a>; el cálculo de la base, en la <a href="/guias/base-reguladora-jubilacion/" class="text-brand hover:underline">guía de la base reguladora</a>.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Qué mirar en tu informe de bases de cotización</h2>
      <p>
        El dato que mejor afina la simulación es tu base de cotización real, que no siempre coincide con el sueldo bruto. Aparece en cada nómina como «base de contingencias comunes» e incluye la parte proporcional de las pagas extra. Si cobras más que la base máxima, tu base es la máxima, y eso fija el techo de tu futura pensión aunque tu salario siga subiendo. En el informe de bases de Tu Seguridad Social verás además los meses sin cotizar: son los que la ley rellena con la base mínima en los 48 primeros y con la mitad en los siguientes.
      </p>
      <p>
        Revisa también tu vida laboral, que da los días cotizados. Los periodos de paro con prestación cotizan; el subsidio para mayores de 52 años cotiza por jubilación; los periodos de excedencia por cuidado de hijos computan como cotizados hasta tres años. Los años trabajados en otro país de la Unión Europea cuentan para alcanzar los 15 años mínimos, pero no los paga España. Si tus cifras no cuadran, la Seguridad Social permite pedir la corrección de la vida laboral con los contratos y las nóminas.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Cómo se pide la pensión</h2>
      <p>
        La solicitud se presenta en la sede electrónica de la Seguridad Social o en un centro de atención e información, hasta tres meses antes de la fecha prevista de jubilación; si se presenta después de dejar de trabajar, los efectos se retrotraen tres meses como máximo. Necesitas el DNI o NIE, y la entidad gestora consulta por su cuenta tu vida laboral y tus bases. Conviene revisar antes ambos informes para corregir lagunas o periodos mal registrados, porque cualquier mes que falte puede reducir el porcentaje o la base reguladora.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Hipótesis del simulador</h2>
      <p>
        El simulador reconstruye tus bases mensuales a partir de la base actual y de una evolución real anual (0 % por defecto): todo se expresa en euros de 2026, como hace la Seguridad Social al actualizar por el IPC las bases antiguas. Supone una carrera continua hasta hoy y, si lo indicas, hasta la jubilación; los meses anteriores al inicio de tu carrera que caen en el periodo de cálculo se integran con la base mínima (48 meses al 100 % y el resto al 50 %). No modeliza el trabajo a tiempo parcial, el pluriempleo, los regímenes especiales ni la jubilación parcial o flexible. Para la cifra oficial, consulta tu informe de bases en Tu Seguridad Social y compara. También puedes ver la <a href="/guias/jubilacion-espana-edad-pension/" class="text-brand hover:underline">guía general de la jubilación en España</a>.
      </p>
    </div>
  </section>
</CalculadoraLayout>
