---
import Layout from '../../../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR } from '../../../config';
import { buildBreadcrumbSchema } from '../../../lib/seo';

const title = `IRPF and Social Security news: what changes in Spain in ${CURRENT_FISCAL_YEAR}`;
const description = `Tax changes, Social Security updates and fiscal news for Spain in ${CURRENT_FISCAL_YEAR}: IRPF, pensions, self-employed contributions and payroll rules, explained simply.`;

const articles = [
  {
    date: '2026-01-15',
    title: `New IRPF tax brackets for ${CURRENT_FISCAL_YEAR}: how your payslip changes`,
    summary: `The General State Budget for ${CURRENT_FISCAL_YEAR} has introduced adjustments to the national IRPF brackets. We analyse the impact on net salaries by income level and autonomous community.`,
  },
  {
    date: '2026-01-10',
    title: `Social Security contribution bases ${CURRENT_FISCAL_YEAR}: new caps and rates`,
    summary: `The maximum contribution base rises to 5,101.20 euros per month. We review how this affects Social Security deductions on your payslip and benefit calculations.`,
  },
  {
    date: '2026-01-08',
    title: `Self-employed contributions ${CURRENT_FISCAL_YEAR}: third phase of the income-based system`,
    summary: `The income-based contribution system enters its third phase in ${CURRENT_FISCAL_YEAR}. The 15 tranches adjust with minimum contributions from 200 to 590 euros per month.`,
  },
  {
    date: '2026-01-05',
    title: `SMI ${CURRENT_FISCAL_YEAR}: Spain's minimum wage rises 4%`,
    summary: `The minimum interprofessional wage is set at 1,184 euros per month (14 payments). We analyse the impact on contributions, unemployment benefits, and salary top-ups.`,
  },
  {
    date: '2025-12-28',
    title: `Pension reform: retirement and MEI changes for ${CURRENT_FISCAL_YEAR}`,
    summary: `The Intergenerational Equity Mechanism (MEI) rises to 0.80% and the solidarity contribution is expanded. We explain how this affects your payslip and retirement planning.`,
  },
  {
    date: '2025-12-20',
    title: `Regional tax deductions ${CURRENT_FISCAL_YEAR}: changes in Madrid, Catalonia, and Andalusia`,
    summary: `Several autonomous communities have modified their regional IRPF deductions. We compare the impact on net salary for gross salaries of 25,000, 40,000, and 60,000 euros per year.`,
  },
];

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'News', url: '/en/news/' },
  ]),
];
const faqPage = [
  { question: 'What does this section cover?', answer: 'Changes affecting take-home pay in Spain: income tax scales, contribution rates, the minimum wage, contribution ceilings and pension rules. Each entry states the date a change takes effect, since payroll and the annual return can follow different rules in the same year.' },
  { question: 'How often is it updated?', answer: 'When a rule changes, which clusters in January with the new figures and around the approval of the state budget. There is no fixed schedule: filling the gaps with commentary would only obscure what actually matters. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
  { question: 'Do changes apply retroactively?', answer: 'Occasionally. Minimum wage increases have been approved in February with effect from 1 January, forcing employers to regularise payslips already issued. Where that happens, the entry says so and explains how it appears on the payslip. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
  { question: 'Where can I verify this information?', answer: 'Each entry links the BOE, the Tax Agency or the Social Security administration. Those sources are the authority; this section exists to flag what changed and what it means in practice, not to replace the official text. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
];
const faqPageSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqPage.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---

<Layout title={title} description={description} schema={schemas} locale="en">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray">
      <a href="/en/" class="hover:text-brand">Home</a> / <span class="text-charcoal dark:text-gray-200">News</span>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      Spain Tax News {CURRENT_FISCAL_YEAR}
    </h1>

    <p class="mb-8 text-lg text-dark-gray dark:text-gray-300">
      Tax changes, new contribution rates, and updates to Spanish labour and tax regulations.
    </p>

    <div class="space-y-6">
      {articles.map(article => (
        <article class="rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
          <time class="text-xs font-medium text-medium-gray" datetime={article.date}>
            {new Date(article.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h2 class="mt-2 mb-2 text-xl font-bold text-charcoal dark:text-gray-100">{article.title}</h2>
          <p class="text-sm text-dark-gray dark:text-gray-300">{article.summary}</p>
        </article>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="mb-4 text-2xl font-bold">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqPage.map((f) => (
        <details class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <summary class="cursor-pointer font-semibold">{f.question}</summary>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
