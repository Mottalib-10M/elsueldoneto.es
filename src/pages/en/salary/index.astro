---
import Layout from '../../../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR } from '../../../config';
import { buildBreadcrumbSchema } from '../../../lib/seo';
import { allSalaryPagesEn, formatAmountEnglish } from '../../../data/salary-pages-config-en';
import { calcularSueldoNeto, situacionFamiliarDefecto } from '../../../lib/irpf-engine';
import { formatEuros } from '../../../lib/format-es';

const title = `Gross to Net Salary Table Spain ${CURRENT_FISCAL_YEAR}: Every Amount`;
const description = `How much net salary do you keep from each gross amount in Spain? Full table with monthly and annual figures, IRPF and Social Security breakdown. Data ${CURRENT_FISCAL_YEAR}.`;

const monthlyPages = allSalaryPagesEn.filter(p => p.period === 'month');
const annualPages = allSalaryPagesEn.filter(p => p.period === 'year');

function getNet(annualGross: number): number {
  return calcularSueldoNeto(annualGross, 'MD', situacionFamiliarDefecto, 14).netoMensual;
}

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'Salaries', url: '/en/salary/' },
  ]),
];
const faqPage = [
  { question: 'How are these figures calculated?', answer: 'Each page applies the state IRPF scale, the Madrid regional scale as a reference and the 2026 contribution rates, assuming a single taxpayer with no children and fourteen payments. Other regions and family situations are handled by the main calculator.' },
  { question: 'Why is Madrid used as the reference?', answer: 'Because it has the lowest regional scale, which gives a stable point of comparison. In Catalonia or Valencia the same gross salary produces slightly less net pay, and the gap widens as income rises. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
  { question: 'Do the figures include extra payments?', answer: 'Yes. The annual total is identical with twelve or fourteen payments; only the monthly distribution changes. Both scenarios are shown because the choice affects household cash flow rather than the total received over the year. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
  { question: 'What do these pages not show?', answer: 'They exclude benefits in kind, private health insurance, meal vouchers and company pension plans, all of which change actual net pay. They also exclude regional deductions for housing, children or disability, which apply in the annual return. Each page links the official source it relies on, so any figure can be checked without depending on us.' },
];
const faqPageSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqPage.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---

<Layout title={title} description={description} schema={schemas} locale="en">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray">
      <a href="/en/" class="hover:text-brand">Home</a> / <span class="text-charcoal dark:text-gray-200">Salaries</span>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      Gross to Net Salary Table in Spain ({CURRENT_FISCAL_YEAR})
    </h1>

    <p class="mb-8 text-lg text-dark-gray dark:text-gray-300">
      Check the approximate net salary for the most searched gross amounts in Spain.
      Each link leads to a detailed page with breakdown by autonomous community and family situation.
    </p>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-charcoal dark:text-gray-100">By monthly salary</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-700">
              <th class="px-4 py-2 text-left font-medium text-gray-500">Gross/month</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Net/month (Madrid)</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">Gross/year</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500"></th>
            </tr>
          </thead>
          <tbody>
            {monthlyPages.map(p => (
              <tr class="border-t border-gray-100 dark:border-gray-700">
                <td class="px-4 py-2 font-medium text-charcoal dark:text-gray-100">€{formatAmountEnglish(p.amount)}</td>
                <td class="px-4 py-2 text-right tabular-nums font-medium text-emerald-700 dark:text-emerald-400">{formatEuros(getNet(p.annualGross))}</td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-500">€{formatAmountEnglish(p.annualGross)}</td>
                <td class="px-4 py-2"><a href={`/en/salary/${p.slug}/`} class="text-brand hover:underline">Details</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-charcoal dark:text-gray-100">By annual salary</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-700">
              <th class="px-4 py-2 text-left font-medium text-gray-500">Gross/year</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Net/month (Madrid)</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">≈ Gross/month</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500"></th>
            </tr>
          </thead>
          <tbody>
            {annualPages.map(p => (
              <tr class="border-t border-gray-100 dark:border-gray-700">
                <td class="px-4 py-2 font-medium text-charcoal dark:text-gray-100">€{formatAmountEnglish(p.amount)}</td>
                <td class="px-4 py-2 text-right tabular-nums font-medium text-emerald-700 dark:text-emerald-400">{formatEuros(getNet(p.annualGross))}</td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-500">€{formatAmountEnglish(Math.round(p.annualGross / 14))}</td>
                <td class="px-4 py-2"><a href={`/en/salary/${p.slug}/`} class="text-brand hover:underline">Details</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="text-xs text-medium-gray">
      <p>Calculated for a single person, no children, Madrid, 14 payments. Fiscal year {CURRENT_FISCAL_YEAR}.</p>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="mb-4 text-2xl font-bold">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqPage.map((f) => (
        <details class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <summary class="cursor-pointer font-semibold">{f.question}</summary>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
