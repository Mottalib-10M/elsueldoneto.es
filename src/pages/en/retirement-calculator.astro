---
import CalculadoraLayout from '../../layouts/CalculadoraLayout.astro';
import Jubilacion from '../../components/calculadoras/Jubilacion';
import { calcularJubilacion, PARAMS_JUBILACION as J, BASES_2026 } from '../../lib/jubilacion-engine';
import { fuentesJubilacion, enFuentes, eurEN as eur, eurEN2 as eur2, numEN as num } from '../../lib/fuentes';

const hoy = new Date().toISOString().slice(0, 10);
const ref = { hoyAnio: 2026, hoyMes: 10 };
const tom = calcularJubilacion({ anioNacimiento: 1966, mesNacimiento: 4, mesesCotizadosHoy: 264, baseActual: 3400, ...ref });
const tomGap = calcularJubilacion({ anioNacimiento: 1966, mesNacimiento: 4, mesesCotizadosHoy: 264, baseActual: 3400, sigueCotizando: false, ...ref });
const sue = calcularJubilacion({ anioNacimiento: 1962, mesNacimiento: 11, mesesCotizadosHoy: 492, baseActual: BASES_2026.maxima, ...ref });
const sueLate = calcularJubilacion({ anioNacimiento: 1962, mesNacimiento: 11, mesesCotizadosHoy: 492, baseActual: BASES_2026.maxima, edadDeseadaMeses: 780 + 24, ...ref });
const E26 = J.edad['2026'], E27 = J.edad['2027'];
const N26 = J.baseReguladora.nueva['2026'];
const age = (m: number) => `${Math.floor(m / 12)} years${m % 12 ? ` and ${m % 12} months` : ''}`;
const mm = (k: 'conyugeACargo' | 'unipersonal' | 'conyugeNoACargo') => eur(J.minimasAnuales['65'][k] / J.pagasAnuales);

const title = 'State Pension Spain 2026: Retirement Calculator (Jubilación)';
const description = 'Estimate your state pension in Spain for 2026: regulatory base under both formulas, contribution years, retirement age, early retirement, minimum and maximum.';
const faqs = [
  { question: 'How many years do I need to contribute to get a Spanish pension?', answer: `At least fifteen years, two of them within the fifteen years before you retire. Fifteen years give ${J.porcentaje.base}% of your regulatory base. A full pension needs 36 years and 6 months if you retire in 2026 and 37 years from 2027. Contributions in other EU countries count towards the fifteen-year minimum.` },
  { question: 'What is the retirement age in Spain in 2026?', answer: `65 if you have contributed for at least 38 years and 3 months; otherwise ${age(E26.edadSinUmbralMeses)}. From 2027 the schedule reaches its end point: 65 with 38 years and 6 months of contributions, ${age(E27.edadSinUmbralMeses)} for everyone else. The age is counted in months from your date of birth.` },
  { question: 'Do years worked abroad count?', answer: 'For EU, EEA and Swiss periods, and for countries with a social security agreement with Spain such as the United Kingdom, foreign years count towards the minimum, but each country pays its own share of the pension. This calculator only estimates the Spanish part, as if all your contributions were in Spain.' },
  { question: 'What is the maximum Spanish state pension?', answer: `${eur(J.pensionMaximaMensual)} a month in 14 payments, or ${eur(J.pensionMaximaAnual)} a year, under Royal Decree-law 3/2026. However high your salary and your contributions were, the pension stops there, which is why high earners in Spain often top up with private or company pension plans. Deferring retirement can still pay off above the cap.` },
  { question: 'Is the Spanish pension paid in 12 or 14 instalments?', answer: 'Fourteen: one each month plus an extra payment in June and another in November. The monthly figure from the calculator is one of those fourteen. Multiply by 14 for the annual amount, or by 14 and divide by 12 to compare with a monthly salary paid in twelve instalments.' },
  { question: 'How early can I retire, and what does it cost?', answer: 'Yes, voluntarily up to two years before your ordinary age if you have 35 years of contributions, or up to four years after losing your job involuntarily if you have 33. Each month early reduces the pension for life, by a percentage that depends on your career length; the calculator applies the official tables.' },
];
---

<CalculadoraLayout title={title} description={description} h1="Spanish state pension calculator (2026)" calculatorName="Retirement pension calculator" path="/en/retirement-calculator/" faqs={faqs} locale="en" sources={enFuentes(fuentesJubilacion)}>
  <p class="mb-6 text-lg text-dark-gray dark:text-gray-300">
    The Spanish state retirement pension, the pensión de jubilación, is a percentage of your regulatory base (base reguladora), which is an average of the monthly social security bases you contributed on. The percentage rises with your years of contributions, from {J.porcentaje.base}% after 15 years to 100% after 36 years and 6 months in 2026. Since January 2026 Social Security works out the base two ways and pays the higher one: the classic formula, 300 months divided by 350, and the new one, which in 2026 adds your best {N26[1]} bases out of the last {N26[0]} months and divides by {num(N26[2], 2)}. The pension is paid in 14 instalments, capped at {eur(J.pensionMaximaMensual)} a month, and topped up to a minimum for people on low incomes. Enter your year of birth, your contribution years and your current base to see your ordinary retirement age and an estimate in 2026 euros.
  </p>
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800" data-chrome>
    <Jubilacion client:idle hoy={hoy} lang="en" />
  </div>

  <section class="mt-8">
    <div class="prose max-w-none text-dark-gray dark:text-gray-300 leading-relaxed">
      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">If you moved to Spain mid-career</h2>
      <p>
        Many readers of this page arrived in Spain in their thirties or forties. Take someone born in April 1966 who has contributed in Spain for 22 years, on a base of €3,400 a month. If they keep working, they reach {age(tom.mesesCotizados)} of contributions at their ordinary age of {age(tom.edadOrdinariaMeses)}, which gives {num(tom.porcentaje, 2)}% of a regulatory base of {eur(tom.baseReguladora)}: {eur(tom.pensionMensual)} a month from {tom.anioHecho}. If they stopped contributing today, for example by returning home, the years until retirement would count as gaps: the base would be filled partly with the minimum base and the percentage would stay at {num(tomGap.porcentaje, 2)}%, leaving {eur(tomGap.pensionMensual)}. Periods worked in another EU country are paid separately by that country.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">The 2026 reform in plain English</h2>
      <p>
        Royal Decree-law 2/2023 lengthened the period used to compute the pension, with a safeguard: until 2040 Social Security calculates the base under both the 2023 rules and the new rules and pays whichever is higher (transitional provision 4.7 of the General Social Security Act). The new formula is phased in. In 2026 it looks at {N26[0]} months and drops the two lowest; every year it adds four months and drops one more, until 2037, when it reaches 348 months with the best 324 kept and a divisor of 378. That helps people whose last years were poorly paid or interrupted. People whose pay rose steadily to the end usually keep the classic result.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Retirement age and the 65 threshold</h2>
      <p>
        Spain has two ordinary ages rather than one. In 2026 you can retire at 65 with 38 years and 3 months of contributions; otherwise at {age(E26.edadSinUmbralMeses)}. From 2027 the figures are 38 years and 6 months, or {age(E27.edadSinUmbralMeses)}. Contributions made abroad count to reach the minimum fifteen years but, under EU coordination rules, the Spanish pension is calculated pro rata.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">High earners: the cap and the reward for working longer</h2>
      <p>
        A senior employee born in November 1962 who has always contributed on the maximum base ({eur2(BASES_2026.maxima)} a month in 2026) reaches the cap straight away: {eur(sue.pensionMensual)} a month at {age(sue.edadJubilacionMeses)}. Working two more years adds {J.demora.porcentajeAnual}% per full year. Because the pension is already capped, the unused percentage is paid separately as an annual sum of {eur(sueLate.complementoDemoraAnual)}, spread across the 14 payments. A lump-sum option also exists. See the <a href="/en/guides/early-retirement-reduction/" class="text-brand hover:underline">early retirement guide</a> for the opposite choice.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Minimum pensions in 2026</h2>
      <p>
        Royal Decree-law 3/2026 sets the minimum retirement pension from age 65 at {mm('conyugeACargo')} a month with a dependent spouse, {mm('unipersonal')} for a single-person household and {mm('conyugeNoACargo')} with a spouse who is not dependent, always in 14 payments. The top-up is means-tested: your other income must stay below {eur(J.limiteIngresosMinimos.sinConyuge)} a year ({eur(J.limiteIngresosMinimos.conConyuge)} with a dependent spouse) and you must live in Spain. A gender-gap supplement of {eur(J.complementoBrechaMensualPorHijo)} a month per child, up to four, is paid to one parent who meets the conditions. Details in the <a href="/en/guides/minimum-and-maximum-pension/" class="text-brand hover:underline">minimum and maximum pension guide</a> and the <a href="/en/guides/pension-regulatory-base/" class="text-brand hover:underline">regulatory base guide</a>.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">How to read the estimate</h2>
      <p>
        Figures are in 2026 euros: past bases are treated as updated for inflation, as Social Security does, and future inflation is ignored. The calculator assumes a continuous career up to today and fills earlier months inside the calculation window with the minimum base, 48 months in full and the rest at half. It does not handle part-time work, multiple jobs, special schemes or partial retirement. Your official contribution record is available from Tu Seguridad Social with a digital certificate or Cl@ve. The <a href="/en/guides/retirement-spain-age-pension/" class="text-brand hover:underline">overview of retirement in Spain</a> covers the rest.
      </p>
    </div>
  </section>
</CalculadoraLayout>
