---
import Layout from '../../../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR } from '../../../config';
import { buildBreadcrumbSchema, buildFAQSchema, buildArticleSchema } from '../../../lib/seo';
import AuthorByline from '../../../components/layout/AuthorByline.astro';
import { calcularJubilacion, PARAMS_JUBILACION as J } from '../../../lib/jubilacion-engine';
import { eurEN as eur, eurEN2 as eur2, numEN as num } from '../../../lib/fuentes';
const N26 = J.baseReguladora.nueva['2026'];
const CV = J.anticipada.coefVoluntaria as Record<string, number[]>, CI = J.anticipada.coefInvoluntaria as Record<string, number[]>;
const ex = calcularJubilacion({ anioNacimiento: 1961, mesNacimiento: 4, mesesCotizadosHoy: 462, baseActual: 2800, hoyAnio: 2026, hoyMes: 10 });
const exLate = calcularJubilacion({ anioNacimiento: 1961, mesNacimiento: 4, mesesCotizadosHoy: 462, baseActual: 2800, edadDeseadaMeses: 804, hoyAnio: 2026, hoyMes: 10 });
const MM = J.minimasAnuales;

const title = `Retirement in Spain ${CURRENT_FISCAL_YEAR}: Pension Age, Amount & Requirements`;
const description = 'What age can you retire and how much pension will you get? Retirement age, pension calculation, contribution years, early and partial retirement in Spain.';

const faqs = [
  { question: 'What is the retirement age in Spain?', answer: `In ${CURRENT_FISCAL_YEAR}, the ordinary retirement age is 65 if you have contributed at least 38 years and 3 months, or 66 years and 10 months with fewer contribution years. The age is gradually increasing toward 67 by 2027 for those with less than 38.5 years of contributions.` },
  { question: 'How is the retirement pension calculated?', answer: `Your pension is a percentage of the regulatory base. Since 2026 Social Security computes it two ways and pays the higher: the last 300 monthly bases divided by 350, or the best ${N26[1]} of the last ${N26[0]} divided by ${N26[2]}. The percentage is 50% at 15 years of contributions, rising to 100% at 36 years and 6 months in 2026.` },
  { question: 'Can I retire early in Spain?', answer: 'Yes, voluntary early retirement is possible up to 2 years before the ordinary age if you have at least 35 years of contributions. Involuntary early retirement (due to company restructuring) allows retiring up to 4 years early with at least 33 years of contributions. Reduction coefficients apply in both cases.' },
];

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'Guides', url: '/en/guides/' },
    { name: 'Retirement in Spain', url: '/en/guides/retirement-spain-age-pension/' },
  ]),
  buildFAQSchema(faqs, 'en'),
  buildArticleSchema(title, description, Astro.url.pathname, 'en'),
];
import MiniSimAutonome from '../../../components/calc/MiniSimAutonome';
---

<Layout title={title} description={description} schema={schemas} locale="en">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray">
      <a href="/en/" class="hover:text-brand">Home</a> /
      <a href="/en/guides/" class="hover:text-brand">Guides</a> /
      <span class="text-charcoal dark:text-gray-200">Retirement in Spain</span>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      Retirement in Spain: Age, Pension & Calculation ({CURRENT_FISCAL_YEAR})
    </h1>

    <AuthorByline locale="en" />

    <div class="prose prose-sm max-w-none text-dark-gray dark:text-gray-300 space-y-6">
      <p>
        Spain's public pension system is one of the most generous in Europe, but understanding its rules requires navigating retirement ages, contribution periods, and regulatory base calculations. Whether you are planning ahead or approaching retirement, this guide covers the key factors that determine how much pension you will receive and when you can start collecting it. Three numbers decide a Spanish pension. The retirement age, which is rising towards 67 and depends on how long you have contributed. The contribution period, with 15 years the minimum to qualify at all and 36 years and 6 months needed for the full percentage in 2026. And the regulatory base, computed from the contribution bases of the final years of a career, currently the last 25, revalued for inflation. Early retirement is possible but applies a permanent reduction for each month brought forward.
      </p>
<MiniSimAutonome client:visible kind="edad" lang="en" locale="en-GB" href="/en/retirement-calculator/" />


      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Retirement Age</h2>
      <p>
        Spain is in the middle of a gradual transition toward a retirement age of 67. In {CURRENT_FISCAL_YEAR}, you can retire at 65 if you have accumulated at least 38 years and 3 months of contributions. If your contribution history is shorter, the ordinary retirement age rises to 66 years and 10 months. This transition, mandated by the 2011 reform, will be complete by 2027. You can check your exact retirement age using the Social Security portal (<em>Tu Seguridad Social</em>).
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Regulatory Base and Pension Amount</h2>
      <p>
        Your pension amount starts with the <em>base reguladora</em> (regulatory base), an average of your monthly contribution bases. Since January 2026 it is calculated two ways and the higher result applies: the last 300 months divided by 350, or, under the new phased-in rule, the best {N26[1]} bases of the last {N26[0]} months divided by {num(N26[2], 2)}. A percentage is then applied based on your total contribution years: 15 years grant 50% of the base, and each extra month adds a little until 100% at 36 years and 6 months (37 years from 2027). The maximum pension in {CURRENT_FISCAL_YEAR} is {eur2(J.pensionMaximaMensual)} a month, paid in 14 instalments. The <a href="/en/guides/pension-regulatory-base/" class="text-brand hover:underline">regulatory base guide</a> has worked examples.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Early and Partial Retirement</h2>
      <p>
        Voluntary early retirement is available up to two years before your ordinary retirement age if you have at least 35 years of contributions. The pension is reduced by a coefficient for each month or part month you retire early, from {num(CV['1'][3], 2)}% for one month to {num(CV['24'][0], 2)}% for two years, depending also on your career length. Involuntary early retirement (after a collective or objective dismissal, among other causes) allows retiring up to four years early with 33 years of contributions, with a reduction of up to {num(CI['48'][0], 2)}%. Details in the <a href="/en/guides/early-retirement-reduction/" class="text-brand hover:underline">early retirement guide</a>. Partial retirement is another option, allowing you to reduce your working hours while receiving a proportional pension, typically combined with a relief contract for a younger worker.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Retirement Age Transition Table (2024-2027)</h2>
      <p>
        Spain is phasing in a higher retirement age between 2013 and 2027. The following table shows the ordinary retirement age based on the year of retirement and total contribution years:
      </p>
      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-gray-300 dark:border-gray-600">
              <th class="py-2 pr-4 text-left font-semibold">Year</th>
              <th class="py-2 pr-4 text-right font-semibold">With 38+ Years Contributed</th>
              <th class="py-2 text-right font-semibold">With Fewer Years</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">2024</td>
              <td class="py-2 pr-4 text-right">65 years</td>
              <td class="py-2 text-right">66 years, 6 months</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">2025</td>
              <td class="py-2 pr-4 text-right">65 years</td>
              <td class="py-2 text-right">66 years, 8 months</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">2026</td>
              <td class="py-2 pr-4 text-right">65 years</td>
              <td class="py-2 text-right">66 years, 10 months</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">2027+</td>
              <td class="py-2 pr-4 text-right">65 years</td>
              <td class="py-2 text-right">67 years</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        From 2027 onward, the system stabilizes: you retire at 65 if you have at least 38 years and 6 months of contributions, or at 67 if you have fewer. The exact threshold for contribution years to qualify for the lower age has been gradually increasing and settles at 38 years and 6 months.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Pension Calculation Example</h2>
      <p>
        Take a worker born in April 1961 who has contributed for 38 years and 6 months on a steady base of €2,800 a month. That is more than the 38 years and 3 months needed in 2026, so the ordinary age is {Math.floor(ex.edadOrdinariaMeses / 12)} and the pension can start now, in {ex.anioHecho}. The two formulas give regulatory bases of {eur2(ex.baseAntigua ?? 0)} and {eur2(ex.baseNueva)}; the higher one, {eur2(ex.baseReguladora)}, applies. With more than 36 years and 6 months the percentage is {num(ex.porcentaje, 2)}%, so the pension is {eur2(ex.pensionMensual)} a month, or {eur(ex.pensionAnual)} a year in 14 payments, before income tax.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Maximum and Minimum Pension Amounts</h2>
      <p>
        Royal Decree-law 3/2026 sets the 2026 amounts, paid in 14 instalments:
      </p>
      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-sm">
          <caption class="sr-only">Minimum and maximum retirement pensions in Spain in 2026</caption>
          <thead>
            <tr class="border-b border-gray-300 dark:border-gray-600">
              <th scope="col" class="py-2 pr-4 text-left font-semibold">Retirement pension</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">Minimum, dependent spouse</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">Minimum, living alone</th>
              <th scope="col" class="py-2 text-right font-semibold">Maximum</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-200 dark:border-gray-700"><td class="py-2 pr-4">Aged 65 or over</td><td class="py-2 pr-4 text-right">{eur2(MM['65'].conyugeACargo / 14)}</td><td class="py-2 pr-4 text-right">{eur2(MM['65'].unipersonal / 14)}</td><td class="py-2 text-right">{eur2(J.pensionMaximaMensual)}</td></tr>
            <tr class="border-b border-gray-200 dark:border-gray-700"><td class="py-2 pr-4">Under 65</td><td class="py-2 pr-4 text-right">{eur2(MM.menor65.conyugeACargo / 14)}</td><td class="py-2 pr-4 text-right">{eur2(MM.menor65.unipersonal / 14)}</td><td class="py-2 text-right">{eur2(J.pensionMaximaMensual)}</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        The top-up to the minimum is means-tested and requires residence in Spain; the maximum applies however high your contributions were. See the <a href="/en/guides/minimum-and-maximum-pension/" class="text-brand hover:underline">minimum and maximum pension guide</a>.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Survivors' Pensions</h2>
      <p>
        Spain's Social Security system provides several types of survivors' pensions for family members of deceased workers or pensioners:
      </p>
      <ul>
        <li><strong>Widowhood pension (<em>pension de viudedad</em>):</strong> The surviving spouse receives 52% of the deceased's regulatory base, which can increase to 60% or even 70% in cases of low income, family responsibilities, or age over 65. Common-law partners may also qualify if they meet specific cohabitation and income requirements.</li>
        <li><strong>Orphan pension (<em>pension de orfandad</em>):</strong> Each child under 21 (or under 25 if unemployed) receives 20% of the regulatory base. In cases where both parents have died, the percentage increases. The combined total of widowhood and orphan pensions cannot exceed 100% of the regulatory base.</li>
        <li><strong>Pension for family members (<em>pension en favor de familiares</em>):</strong> In the absence of a spouse or children, dependent grandchildren, siblings, parents, or grandparents who lived with and depended financially on the deceased may qualify for 20% of the regulatory base.</li>
      </ul>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Pensions for Expats: Contributions in Multiple Countries</h2>
      <p>
        If you have worked in multiple EU/EEA countries, your pension rights are coordinated under European regulations (EC 883/2004). Each country where you have contributed calculates a partial pension based on the years you contributed there, but using the total career across all countries to determine your eligibility percentage. This means:
      </p>
      <ul>
        <li><strong>Aggregation of periods:</strong> If you need 15 years of contributions to qualify in Spain but only contributed 8 years there, Spain will count your years in other EU countries to meet the 15-year threshold. You then receive a pension proportional to your 8 years in Spain.</li>
        <li><strong>Pro-rata calculation:</strong> Each country calculates what your pension would be if all your career had been in that country (the theoretical amount), then reduces it in proportion to the time you actually contributed there (the pro-rata amount). You receive the pro-rata amount from each country.</li>
        <li><strong>Non-EU bilateral agreements:</strong> Spain has Social Security agreements with many non-EU countries, including the United States, Canada, Australia, Japan, and most Latin American countries. These agreements similarly allow aggregation of contribution periods, though the exact rules vary by treaty.</li>
        <li><strong>Where to apply:</strong> You apply for your pension in the country where you live. That country's Social Security office coordinates with the other countries to calculate your entitlement from each one.</li>
      </ul>
      <p>
        For expats who have spent portions of their career in different countries, this coordination system is essential. It prevents the loss of pension rights due to mobility and ensures that every year of contributions counts, regardless of where it was earned.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">The MEI: Sustainability Reform</h2>
      <p>
        The Intergenerational Equity Mechanism (<em>Mecanismo de Equidad Intergeneracional</em>, or MEI) was introduced in 2023 as part of Spain's pension sustainability reform. It is an additional Social Security contribution of 0.90% in 2026, split between employer (0.75%) and employee (0.15%), applied on top of existing contribution rates. The MEI replaces the earlier Sustainability Factor that was never implemented due to political opposition.
      </p>
      <p>
        The funds collected through the MEI are directed to a reserve fund designed to cover projected pension shortfalls between 2032 and 2050, when the baby boomer generation will be fully retired. The MEI rate is scheduled to increase gradually, reaching 1.2% by 2029. If the reserve fund proves insufficient, the rate could be further increased, or alternative measures (such as adjusting pension growth or contribution bases) would be implemented.
      </p>
      <p>
        For workers, the MEI adds a small but noticeable cost. On a salary of €35,000, the employee MEI contribution is €52.50 per year. While modest individually, the mechanism is designed to accumulate substantial reserves over the next decade to ensure pension sustainability for future retirees.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Early Retirement Requirements Summary</h2>
      <p>
        The following table summarizes the key requirements for each type of early retirement:
      </p>
      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-gray-300 dark:border-gray-600">
              <th class="py-2 pr-4 text-left font-semibold">Type</th>
              <th class="py-2 pr-4 text-right font-semibold">Max Years Early</th>
              <th class="py-2 pr-4 text-right font-semibold">Min. Contributions</th>
              <th class="py-2 text-right font-semibold">Reduction (1 month to maximum)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">Voluntary</td>
              <td class="py-2 pr-4 text-right">2 years</td>
              <td class="py-2 pr-4 text-right">35 years</td>
              <td class="py-2 text-right">{num(CV['1'][3], 2)}% - {num(CV['24'][0], 2)}%</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">Involuntary (ERE/restructuring)</td>
              <td class="py-2 pr-4 text-right">4 years</td>
              <td class="py-2 pr-4 text-right">33 years</td>
              <td class="py-2 text-right">{num(CI['1'][3], 2)}% - {num(CI['48'][0], 2)}%</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">Arduous or hazardous work</td>
              <td class="py-2 pr-4 text-right">Varies</td>
              <td class="py-2 pr-4 text-right">15 years (in that role)</td>
              <td class="py-2 text-right">Varies by sector</td>
            </tr>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <td class="py-2 pr-4">Disability (65%+)</td>
              <td class="py-2 pr-4 text-right">No limit</td>
              <td class="py-2 pr-4 text-right">15 years</td>
              <td class="py-2 text-right">No reduction</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        The reduction coefficients mean that early retirement permanently lowers your pension. For voluntary early retirement 24 months before the ordinary age with under 38 years and 6 months of contributions, the reduction is {num(CV['24'][0], 2)}%. This can translate to several hundred euros per month less for the rest of your life, so the decision should be carefully modeled.
      </p>

      <h2 class="text-xl font-bold text-charcoal dark:text-gray-100">Delayed Retirement Bonus</h2>
      <p>
        Workers who keep working beyond their ordinary retirement age earn a bonus of {J.demora.porcentajeAnual}% of the pension for each full year of deferral and, from the second year, {J.demora.porcentajeSemestre}% for each extra half-year (article 210.2 of the General Social Security Act). Instead, you can choose a one-off lump sum, or a combination. For the worker in the example above, retiring at 67, two full years after the ordinary age, would add {num(exLate.porcentajeDemora, 0)}% and raise the pension to {eur2(exLate.pensionMensual)} a month for life, still within the maximum. Active retirement, which lets you work while drawing part of the pension, is only available after deferring at least a year.</p>
    </div>

    <section class="mt-10">
      <h2 class="mb-4 text-2xl font-bold text-charcoal dark:text-gray-100">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
            <summary class="cursor-pointer font-semibold text-charcoal dark:text-gray-100">{faq.question}</summary>
            <p class="mt-2 text-sm text-dark-gray dark:text-gray-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
