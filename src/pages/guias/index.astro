---
import Layout from '../../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR } from '../../config';
import { buildBreadcrumbSchema } from '../../lib/seo';

const title = `Guías Fiscales y Financieras España ${CURRENT_FISCAL_YEAR} - IRPF y Más`;
const description = 'IRPF por tramos, sueldo neto, autónomos, jubilación, finiquito y régimen Beckham explicados paso a paso. Todas las guías fiscales y financieras para España.';

const guias = [
  {
    href: '/guias/como-calcular-sueldo-neto/',
    title: 'Cómo calcular el sueldo neto en España',
    summary: 'Del bruto al neto paso a paso: IRPF por tramos, Seguridad Social, mínimo personal y ejemplos prácticos.',
  },
  {
    href: '/guias/regimen-beckham-explicado/',
    title: 'Régimen Beckham: guía completa',
    summary: 'Qué es la Ley Beckham, quién puede acogerse, tributación al 24%, ventajas, inconvenientes y cómo solicitarlo.',
  },
  {
    href: '/guias/jubilacion-espana-edad-pension/',
    title: 'Jubilación en España: edad, pensión y cómo se calcula',
    summary: 'Edad de jubilación, cálculo de la base reguladora, porcentajes por años cotizados, jubilación anticipada, parcial y activa.',
  },
  {
    href: '/guias/cuotas-autonomos-espana/',
    title: 'Cuotas de autónomos en España: tabla por ingresos reales',
    summary: 'Los 15 tramos de cotización del RETA, tarifa plana, gastos deducibles, IRPF y ejemplo práctico para autónomos.',
  },
  {
    href: '/guias/tramos-irpf-espana/',
    title: 'Tramos del IRPF en España: tablas y tipos por comunidad',
    summary: 'Los 6 tramos estatales, cómo se suman los autonómicos, diferencias entre comunidades, tipo efectivo vs. marginal y ejemplo práctico de cálculo.',
  },
  {
    href: '/guias/irpf-por-comunidad-autonoma/',
    title: 'IRPF por Comunidad Autónoma: comparativa completa',
    summary: 'Ranking de las 17 comunidades por sueldo neto, regímenes forales, deducciones autonómicas y ejemplo práctico Madrid vs Cataluña vs Andalucía.',
  },
  {
    href: '/guias/calcular-finiquito-indemnizacion/',
    title: 'Cómo calcular tu finiquito e indemnización',
    summary: 'Diferencia entre finiquito e indemnización, cálculo de vacaciones, pagas extra, despido improcedente y objetivo, tratamiento fiscal y ejemplo práctico.',
  },
];

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Guías', url: '/guias/' },
  ]),
];
const faqPage = [
  { question: '¿Por qué guía empezar?', answer: 'Por la de cálculo del sueldo neto: explica de dónde sale la diferencia entre el bruto pactado y el ingreso real, que es la duda más frecuente. Las demás guías, sobre IRPF por comunidad, autónomos o jubilación, parten de esa base.' },
  { question: '¿Las guías están actualizadas a 2026?', answer: 'Sí. Las tablas de IRPF, los tipos de cotización, el SMI y los topes de cotización corresponden a los vigentes en 2026, y cada guía muestra su fecha de verificación junto al enlace a la fuente oficial utilizada. Cada página enlaza la fuente oficial aplicable, para que cualquier cifra pueda contrastarse sin depender de nosotros.' },
  { question: '¿Sirven para autónomos?', answer: 'En parte. Las guías fiscales aplican igual, pero las de nómina describen la relación laboral por cuenta ajena. Para el trabajo autónomo, la guía de cotización por ingresos reales y la calculadora específica son el punto de partida adecuado. Cada página enlaza la fuente oficial aplicable, para que cualquier cifra pueda contrastarse sin depender de nosotros.' },
  { question: '¿Sustituyen a un asesor fiscal?', answer: 'No. Describen la regla general y órdenes de magnitud, sin conocer tu convenio, tu situación familiar ni las particularidades de tu contrato. Para una decisión con consecuencias económicas, el asesor o la propia Agencia Tributaria son los interlocutores adecuados. Cada página enlaza la fuente oficial aplicable, para que cualquier cifra pueda contrastarse sin depender de nosotros.' },

  { question: '¿Hay guías específicas para expatriados?', answer: 'Sí. La guía del Régimen Beckham cubre la tributación de los trabajadores desplazados, y la de jubilación explica cómo se suman los periodos cotizados en otros países de la Unión Europea o con convenio bilateral a efectos de la pensión española.' },
  { question: '¿Puedo citar el contenido de las guías?', answer: 'Sí, citando la fuente y enlazando la página original. Reproducir el texto completo no aporta nada al lector y hace perder las actualizaciones: una cifra correcta hoy puede dejar de serlo en seis meses, y solo la página original lleva la fecha de verificación.' },
];
const faqPageSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqPage.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
import ContextoFiscal from '../../components/ContextoFiscal.astro';
---

<Layout title={title} description={description} schema={schemas}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray">
      <a href="/" class="hover:text-brand">Inicio</a> / <span class="text-charcoal dark:text-gray-200">Guías</span>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      Guías Fiscales y Financieras
    </h1>

    <p class="mb-8 text-lg text-dark-gray dark:text-gray-300">
      Artículos detallados para entender la fiscalidad española y tomar mejores decisiones financieras.
    </p>

    <div class="space-y-6">
      {guias.map(guia => (
        <a href={guia.href} class="block rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
          <h2 class="mb-2 text-xl font-bold text-charcoal dark:text-gray-100">{guia.title}</h2>
          <p class="text-sm text-dark-gray dark:text-gray-300">{guia.summary}</p>
          <span class="mt-3 inline-block text-sm font-medium text-brand">Leer guía completa →</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Fuentes oficiales (RECETTE §7) -->
  <section class="mx-auto max-w-6xl px-4 pb-12 text-sm text-slate-600">
    <h2 class="text-lg font-semibold text-slate-900 mb-3">Fuentes oficiales</h2>
    <ul class="list-disc pl-6 space-y-1">
      <li><a class="underline" href="https://www.agenciatributaria.es" rel="noopener">Agencia Tributaria</a> — IRPF y retenciones</li>
      <li><a class="underline" href="https://www.seg-social.es" rel="noopener">Seguridad Social</a> — bases y cuotas de cotización</li>
      <li><a class="underline" href="https://www.sepe.es" rel="noopener">SEPE</a> — prestación por desempleo</li>
      <li><a class="underline" href="https://www.boe.es" rel="noopener">BOE</a> — normativa en vigor</li>
    </ul>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="mb-4 text-2xl font-bold">Preguntas frecuentes</h2>
    <div class="space-y-3">
      {faqPage.map((f) => (
        <details class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <summary class="cursor-pointer font-semibold">{f.question}</summary>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <ContextoFiscal />
</Layout>
