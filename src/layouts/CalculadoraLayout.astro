---
import '../styles/global.css';
import Layout from '../components/layout/Layout.astro';
import { CURRENT_FISCAL_YEAR, AUTHOR_NAME } from '../config';
import { buildWebApplicationSchema, buildBreadcrumbSchema, buildFAQSchema, type FAQItem } from '../lib/seo';
import { getLocaleFromPath, t } from '../i18n';
import type { Locale } from '../i18n/types';

interface Props {
  title: string;
  description: string;
  h1: string;
  calculatorName: string;
  path: string;
  ogImage?: string;
  faqs?: FAQItem[];
  breadcrumbs?: { name: string; url: string }[];
  updatedDate?: string;
  sources?: { label: string; url: string }[];
  locale?: Locale;
}

const {
  title,
  description,
  h1,
  calculatorName,
  path,
  ogImage,
  faqs = [],
  updatedDate = new Date().toISOString().split('T')[0],
  sources = [
    { label: 'AEAT', url: 'https://www.agenciatributaria.gob.es' },
    { label: 'Seguridad Social', url: 'https://www.seg-social.es' },
  ],
  locale: localeProp,
} = Astro.props;

const locale = localeProp || getLocaleFromPath(Astro.url.pathname);

const breadcrumbs = Astro.props.breadcrumbs || [
  { name: t(locale, 'breadcrumbHome'), url: t(locale, 'homeHref') },
  { name: calculatorName, url: path },
];

const schemas = [
  buildWebApplicationSchema(calculatorName, path, locale),
  buildBreadcrumbSchema(breadcrumbs),
  ...(faqs.length > 0 ? [buildFAQSchema(faqs, locale)] : []),
];
---

<Layout title={title} description={description} ogImage={ogImage} schema={schemas} locale={locale}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <nav class="mb-6 text-sm text-medium-gray" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <li class="text-medium-gray">/</li>}
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={crumb.url} class="hover:text-brand">{crumb.name}</a>
              ) : (
                <span class="text-charcoal dark:text-gray-200">{crumb.name}</span>
              )}
            </li>
          </>
        ))}
      </ol>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl dark:text-gray-100">
      {h1}
    </h1>

    <!-- Trust badge -->
    <div class="flex flex-wrap items-center gap-3 mb-6 text-xs text-gray-500 dark:text-gray-400">
      <span class="inline-flex items-center gap-1 rounded-full bg-brand/10 px-2.5 py-1 font-medium text-charcoal dark:text-brand">
        <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        {t(locale, 'updatedFor')} {CURRENT_FISCAL_YEAR}
      </span>
      <span>
        {t(locale, 'byAuthorPrefix')} <a href={t(locale, 'aboutHref')} class="font-medium text-gray-700 dark:text-gray-300 hover:text-brand">{AUTHOR_NAME}, Publisher of calculators and practical guides</a>
      </span>
    </div>

    <slot />

    {faqs.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-6 text-2xl font-bold text-charcoal dark:text-gray-100">
          {t(locale, 'faqTitle')}
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group rounded-lg border border-gray-200 dark:border-gray-700">
              <summary class="cursor-pointer px-4 py-3 font-medium text-charcoal dark:text-gray-200">
                {faq.question}
              </summary>
              <div class="border-t border-gray-200 px-4 py-3 text-sm text-dark-gray dark:border-gray-700 dark:text-gray-300">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 flex items-center gap-4 rounded-lg border border-gray-200 px-5 py-4 dark:border-gray-700">
      <div class="text-sm">
        <p class="font-semibold text-charcoal dark:text-gray-200">
          {locale === 'en' ? 'Written by' : 'Escrito por'} <a href={locale === 'en' ? '/en/about/' : '/sobre-nosotros/'} class="text-brand hover:underline">Radif Partners</a>
        </p>
        <p class="text-medium-gray">Publisher of calculators and practical guides · {locale === 'en' ? 'Finance Expert' : 'Experto en Finanzas'}</p>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-medium-gray">
      <span>{t(locale, 'updatedForFiscalYear')} {CURRENT_FISCAL_YEAR}</span>
      <span>·</span>
      <span>{t(locale, 'lastUpdate')} {updatedDate}</span>
    </div>

    {sources.length > 0 && (
      <div class="mt-4 text-xs text-medium-gray">
        <span class="font-medium">{t(locale, 'sourcesLabel')}</span>
        {sources.map((source, i) => (
          <>
            {i > 0 && ', '}
            <a href={source.url} class="underline hover:text-brand" target="_blank" rel="noopener">
              {source.label}
            </a>
          </>
        ))}
      </div>
    )}
  </div>
</Layout>
